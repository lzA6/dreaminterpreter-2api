# ====================================================================
# dreaminterpreter-2api 配置文件模板
# ====================================================================
#
# 请将此文件重命名为 ".env" 并填入您的凭证。
#

# --- 核心安全配置 (必须设置) ---
# 用于保护您 API 服务的访问密钥。
API_MASTER_KEY=sk-dreaminterpreter-2api-default-key-please-change-me

# --- 部署配置 (可选) ---
# Nginx 对外暴露的端口
NGINX_PORT=8090

# --- Dream Interpreter 凭证 (必须设置) ---
# 1. 登录 https://dreaminterpreter.ai/
# 2. 按 F12 打开开发者工具，切换到“网络”(Network) 面板。
# 3. 输入一个梦境并点击“解释梦”。
# 4. 在网络请求列表中，找到对 "dreaminterpreter.ai" 的 POST 请求。
# 5. 在“标头”(Headers) -> “请求标头”(Request Headers) 中，找到并复制完整的 "cookie" 值。
# 注意：如果您的 Cookie 值中包含 "$" 符号，请手动将其替换为 "$$" (例如, "$o1" 应改为 "$$o1")。
DREAMINTERPRETER_COOKIE="在此处粘贴您的完整 Cookie 字符串"
